{
  "name": "topsun",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @topsun/db",
    "db:studio": "turbo run db:studio -F @topsun/db",
    "db:generate": "turbo run db:generate -F @topsun/db",
    "db:migrate": "turbo run db:migrate -F @topsun/db",
    "db:start": "turbo run db:start -F @topsun/db",
    "db:watch": "turbo run db:watch -F @topsun/db",
    "db:stop": "turbo run db:stop -F @topsun/db",
    "db:down": "turbo run db:down -F @topsun/db",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@topsun/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@topsun/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.9.0"
}
